{
  "name": "comp-setup",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "create:route": "node scripts/create-route.js",
    "create:routes": "node scripts/create-routes.js",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "build:blocks": "pnpm shadcn-svelte registry build",
    "build:example": "pnpm shadcn-svelte registry build ./example.json -o ./registry.json"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/svelte-table": "9.0.0-beta.65",
    "date-fns": "^4.4.0",
    "mode-watcher": "^1.1.0",
    "motion-sv": "^0.1.13",
    "runed": "^0.37.1",
    "sv-agentation": "^0.4.0",
    "svelte-meta-tags": "^5.0.2"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "latest",
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.1",
    "@lucide/svelte": "^1.28.0",
    "@shikijs/langs": "^4.0.2",
    "@shikijs/themes": "^4.0.2",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "latest",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "package-manager-detector": "^1.6.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "shadcn-svelte": "^1.4.2",
    "shiki": "^4.0.2",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "svelte-sonner": "^1.1.1",
    "svelte-toolbelt": "^0.10.6",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
