			"content": "<script lang=\"ts\">\n\timport ChevronsLeftIcon from \"@lucide/svelte/icons/chevrons-left\";\n\timport ChevronLeftIcon from \"@lucide/svelte/icons/chevron-left\";\n\timport ChevronRightIcon from \"@lucide/svelte/icons/chevron-right\";\n\timport ChevronsRightIcon from \"@lucide/svelte/icons/chevrons-right\";\n\timport { Button } from \"$lib/components/ui/button\";\n\timport { cn } from \"$UTILS$.js\";\n\n\tlet {\n\t\tcurrentPage,\n\t\tpageCount,\n\t\tcanPreviousPage,\n\t\tcanNextPage,\n\t\tonPrevious,\n\t\tonNext,\n\t\tonGoToPage,\n\t\tsiblingCount = 1,\n\t\tpageSize = 1,\n\t\ttotalItems = pageCount * pageSize,\n\t\tclass: className\n\t}: {\n\t\tcurrentPage: number;\n\t\tpageCount: number;\n\t\tcanPreviousPage: boolean;\n\t\tcanNextPage: boolean;\n\t\tonPrevious: () => void;\n\t\tonNext: () => void;\n\t\tonGoToPage: (page: number) => void;\n\t\tsiblingCount?: number;\n\t\tpageSize?: number;\n\t\ttotalItems?: number;\n\t\tclass?: string;\n\t} = $props();\n\n\tconst safeTotalItems = $derived(Math.max(totalItems, 0));\n\tconst rangeStart = $derived(\n\t\tsafeTotalItems === 0 ? 0 : (currentPage - 1) * pageSize + 1\n\t);\n\tconst rangeEnd = $derived(Math.min(currentPage * pageSize, safeTotalItems));\n\n\tfunction goToFirstPage() {\n\t\tif (!canPreviousPage) return;\n\t\tonGoToPage(1);\n\t}\n\n\tfunction goToLastPage() {\n\t\tif (!canNextPage) return;\n\t\tonGoToPage(pageCount);\n\t}\n</script>\n\n{#if pageCount > 1}\n\t<nav\n\t\taria-label=\"Table pagination\"\n\t\tclass={cn(\"flex flex-wrap items-center gap-4 sm:gap-6\", className)}\n\t>\n\t\t<p class=\"text-sm font-medium whitespace-nowrap text-foreground\">\n\t\t\t{rangeStart}-{rangeEnd} of {safeTotalItems}\n\t\t</p>\n\n\t\t<div class=\"flex items-center gap-2\">\n\t\t\t<Button\n\t\t\t\ttype=\"button\"\n\t\t\t\tvariant=\"outline\"\n\t\t\t\tsize=\"icon\"\n\t\t\t\tdisabled={!canPreviousPage}\n\t\t\t\taria-label=\"Go to first page\"\n\t\t\t\tonclick={goToFirstPage}\n\t\t\t>\n\t\t\t\t<ChevronsLeftIcon />\n\t\t\t</Button>\n\n\t\t\t<Button\n\t\t\t\ttype=\"button\"\n\t\t\t\tvariant=\"outline\"\n\t\t\t\tsize=\"icon\"\n\t\t\t\tdisabled={!canPreviousPage}\n\t\t\t\taria-label=\"Go to previous page\"\n\t\t\t\tonclick={onPrevious}\n\t\t\t>\n\t\t\t\t<ChevronLeftIcon />\n\t\t\t</Button>\n\n\t\t\t<Button\n\t\t\t\ttype=\"button\"\n\t\t\t\tvariant=\"outline\"\n\t\t\t\tsize=\"icon\"\n\t\t\t\tdisabled={!canNextPage}\n\t\t\t\taria-label=\"Go to next page\"\n\t\t\t\tonclick={onNext}\n\t\t\t>\n\t\t\t\t<ChevronRightIcon />\n\t\t\t</Button>\n\n\t\t\t<Button\n\t\t\t\ttype=\"button\"\n\t\t\t\tvariant=\"outline\"\n\t\t\t\tsize=\"icon\"\n\t\t\t\tdisabled={!canNextPage}\n\t\t\t\taria-label=\"Go to last page\"\n\t\t\t\tonclick={goToLastPage}\n\t\t\t>\n\t\t\t\t<ChevronsRightIcon />\n\t\t\t</Button>\n\t\t</div>\n\t</nav>\n{/if}\n",
